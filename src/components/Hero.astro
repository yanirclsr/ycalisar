---
import { links } from '../data/links';
---

<header id="top" class="hero">
	<div class="wrap">
		<h1>Yanir<br />Calisar</h1>
		<div class="indent">
			<p class="lede">
				I founded <a href={links.tuvis} target="_blank" rel="noopener">Tuvis</a>. It started as a WhatsApp-to-CRM
				tool I built in 24 hours in 2019, raised an $11M seed in 2021, and grew to 150+ enterprise customers in
				10 countries, including 9 of Brazil's 10 largest banks. I stepped down as CEO in 2024.
			</p>
			<p class="lede">
				Now I build apps for runners and musicians, lecture at Reichman University, and train. My marathon best is <span class="mark">3:23:31</span>,
				Tel Aviv, February 2026.
			</p>
			<ul class="links">
				<li><a href="#now">What I'm building</a></li>
				<li><a href="#story">The long version</a></li>
				<li><a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
				<li><a href="#contact">Get in touch</a></li>
			</ul>
		</div>
	</div>
</header>

<style>
	.hero {
		padding: 56px 0 8px;
	}
	h1 {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(4rem, 17vw, 11.5rem);
		line-height: 0.84;
		letter-spacing: -0.045em;
		margin-left: -0.05em;
		margin-bottom: 40px;
	}
	.lede {
		font-size: var(--s1);
		line-height: 1.5;
		max-width: 34em;
	}
	.lede + .lede {
		margin-top: 16px;
	}
	.links {
		margin-top: 28px;
	}
</style>
