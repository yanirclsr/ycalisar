---
import { links } from '../data/links';
---

<footer id="contact" class="block contact">
	<div class="wrap">
		<div class="block-head">
			<h2>Get in touch</h2>
			<p>
				For a lecture, advice on an early-stage company, or a running or diving recommendation, message me on
				LinkedIn.
			</p>
		</div>
		<div class="indent">
			<ul class="links">
				<li><a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
				<li><a href={links.appleDeveloper} target="_blank" rel="noopener">My apps on the App Store</a></li>
				<li><a href={links.github} target="_blank" rel="noopener">GitHub</a></li>
				<li><a href={links.crunchbase} target="_blank" rel="noopener">Crunchbase</a></li>
				<li><a href={links.slideshare} target="_blank" rel="noopener">Slides from past talks</a></li>
			</ul>
			<p class="copy">© {new Date().getFullYear()} Yanir Calisar</p>
		</div>
	</div>
</footer>

<style>
	.contact {
		margin-top: 88px;
		padding-bottom: 72px;
		border-top: 2px solid var(--ink);
	}
	.copy {
		margin-top: 40px;
		color: var(--slate);
		font-size: var(--s-1);
	}
</style>
