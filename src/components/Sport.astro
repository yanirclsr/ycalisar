---
import { races, marathonProgression } from '../data/races';
---

<section id="sport" style="background: var(--bg-elevated);">
	<div class="wrap">
		<p class="eyebrow reveal">Endurance</p>
		<h2 class="section-title reveal">Marathons, triathlon, and a slow climb to sub-3:30.</h2>
		<p class="section-sub reveal">
			Same habits that build companies build fitness: consistency, measurement, and adjusting the plan after
			setbacks.
		</p>

		<div class="card reveal" style="margin-bottom: 32px;">
			<h3 style="font-size: 1rem; color: var(--text-dim); margin-bottom: 16px;">Marathon progression</h3>
			<div style="display: flex; gap: 24px; flex-wrap: wrap;">
				{marathonProgression.map((m) => (
					<div>
						<div style="font-size: 1.8rem; font-weight: 800; color: var(--accent);">{m.result}</div>
						<div class="hook">{m.label}</div>
					</div>
				))}
			</div>
		</div>

		<div style="display: flex; flex-direction: column; gap: 10px;">
			{races.map((r) => (
				<details class="card reveal">
					<summary>
						<span>
							<span class="pill" style="margin-right: 10px;">{r.date}</span>
							{r.name}
						</span>
						<span class="pill accent">{r.result}</span>
					</summary>
					<div class="detail-body">
						<p>{r.distance}</p>
						{r.note && <p style="margin-top: 6px;">{r.note}</p>}
					</div>
				</details>
			))}
		</div>

		<div class="card reveal" style="margin-top: 24px;">
			<p class="hook" style="margin: 0;">
				A side project: running at least 10K in 40 different cities. <span class="ph">[city list and map coming soon]</span>
			</p>
		</div>
	</div>
</section>
