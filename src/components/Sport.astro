---
import { races, racesProfileUrl } from '../data/races';
---

<section id="sport" class="block">
	<div class="wrap">
		<div class="block-head">
			<h2>Running</h2>
			<p>
				First marathon: Tel Aviv, February 2025. Seven months later, 3:57:59 in Berlin in 27°C heat. A year after
				the first, 3:23:31 back in Tel Aviv.
			</p>
		</div>
		<div class="indent">
			<table class="results">
				<caption class="visually-hidden">Personal bests</caption>
				<thead>
					<tr>
						<th scope="col">Distance</th>
						<th scope="col">Time</th>
						<th scope="col">Race</th>
						<th scope="col" class="hide-sm">Pace</th>
					</tr>
				</thead>
				<tbody>
					{races.map((r, i) => (
						<tr>
							<th scope="row">{r.distance}</th>
							<td class="time">{i === 0 ? <span class="mark">{r.result}</span> : r.result}</td>
							<td>{r.name}<span class="sub">{r.date}</span></td>
							<td class="hide-sm">{r.pace ?? ''}</td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="note">
				Every result: <a href={racesProfileUrl} target="_blank" rel="noopener">races.co.il/u/yanir</a>
			</p>
		</div>
	</div>
</section>

<style>
	.results tbody th {
		font-weight: 400;
	}
	.note {
		margin-top: 16px;
		color: var(--slate);
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
