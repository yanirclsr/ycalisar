---
import { timeline } from '../data/timeline';
import { links } from '../data/links';
---

<section id="story" class="block">
	<div class="wrap">
		<div class="block-head">
			<h2>The long version</h2>
			<p>Sales, a pub, enterprise software, code, and back to founding.</p>
		</div>
		<ol class="ledger">
			{timeline.map((item, i) => (
				<li>
					<span class="when">{i === timeline.length - 1 ? <span class="mark">{item.year}</span> : item.year}</span>
					<div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</div>
				</li>
			))}
		</ol>
		<div class="indent more">
			<ul class="links">
				<li><a href={links.tuvis} target="_blank" rel="noopener">tuvis.com</a></li>
				<li><a href={links.tuvisJourneyPost} target="_blank" rel="noopener">How Tuvis started (LinkedIn)</a></li>
				<li><a href="https://www.calcalistech.com/ctech/articles/0,7340,L-3923191,00.html" target="_blank" rel="noopener">Calcalist on the $11M seed</a></li>
				<li><a href={links.tuvisSpanishArticle} target="_blank" rel="noopener">Emprendedores News article (Spanish)</a></li>
			</ul>
		</div>
	</div>
</section>

<style>
	.more {
		margin-top: 20px;
	}
</style>
