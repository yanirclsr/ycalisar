---
import { links } from '../data/links';
import { visitedCountries } from '../data/countries';
import WorldMap from './WorldMap.astro';
---

<section id="travel" class="block">
	<div class="wrap">
		<div class="block-head">
			<h2>{visitedCountries.length} countries, one dive log</h2>
			<p>
				Born in Mexico, raised in Israel, built a business in Brazil. I became a PADI Divemaster in
				2020; my dive log turned into the <a href={links.fourDiversApp} target="_blank" rel="noopener">4divers</a> app.
			</p>
		</div>
		<div class="indent">
			<WorldMap />
			<p class="countries">{visitedCountries.join(', ')}.</p>
		</div>
	</div>
</section>

<style>
	.countries {
		margin-top: 16px;
		color: var(--slate);
		font-size: var(--s-1);
		max-width: var(--measure);
	}
</style>
