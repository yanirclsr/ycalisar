---
import { projects, projectGroups } from '../data/projects';
---

<section id="projects" class="block">
	<div class="wrap">
		<div class="block-head">
			<h2>Everything else</h2>
			<p>Companies, jobs, apps and side projects, newest first.</p>
		</div>
		<div class="block-body">
			{projectGroups.map((group) => (
				<div>
					<h3 class="group">{group}</h3>
					<ul class="ledger">
						{projects.filter((p) => p.group === group).map((p) => (
							<li>
								<span class="when">{p.years}</span>
								<div>
									<h3 class="he">{p.name}</h3>
									<p>{p.text}</p>
									{p.link && (
										<p class="meta">
											<a href={p.link} target="_blank" rel="noopener">{p.linkLabel}</a>
										</p>
									)}
								</div>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.group {
		font-family: var(--display);
		font-weight: 700;
		font-size: var(--s0);
		margin-bottom: 8px;
	}
</style>
