---
import { nowItems } from '../data/now';
---

<section id="now" class="block">
	<div class="wrap">
		<div class="block-head">
			<h2>What I'm working on</h2>
			<p>Updated November 2026.</p>
		</div>
		<ul class="ledger">
			{nowItems.map((item) => (
				<li>
					<span class="when">{item.kind}</span>
					<div>
						<h3 class="he">{item.name}</h3>
						<p>{item.what}</p>
						{item.link && (
							<p class="meta">
								<a href={item.link} target="_blank" rel="noopener">{item.linkLabel}</a>
							</p>
						)}
					</div>
				</li>
			))}
		</ul>
	</div>
</section>
