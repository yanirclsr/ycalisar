---
import { links } from '../data/links';

const videos = [
	{
		id: 'z-7wHEJY8P8',
		title: '20 Minute Leaders',
		text: 'Building Whatslly into Tuvis, from the 24-hour MVP to enterprise customers.',
	},
	{
		id: 'mdlvfRhraw0',
		title: 'Remembering October 7 through running',
		text: 'Why Run 7.10 exists and how the runs work.',
	},
	{
		id: 'YlX_jZ-ZMUs',
		title: 'Knesset Channel',
		text: 'Interview about Run 7.10. In Hebrew.',
	},
];

const podcasts = [
	{
		when: 'May 2025',
		title: 'Product Builder',
		text: 'How to build an enterprise product with hundreds of customers over a weekend. In Hebrew.',
		link: links.productBuilderPodcast,
		linkLabel: 'Spotify',
	},
	{
		when: 'Episode 41',
		title: 'Nomad Podcast',
		text: 'Recorded on Koh Tao, Thailand: running 15 SaaS products at once, validating ideas cheaply, and diving.',
		link: links.nomadPodcast,
		linkLabel: 'nomadpodcast.com',
	},
	{
		when: 'Reichman',
		title: 'Guest lectures and judging',
		text: 'Lectures on the Tuvis story in the business entrepreneurship course, and judging startup competitions.',
		link: links.reichmanEntrepreneurshipPost,
		linkLabel: 'Course post',
	},
	{
		when: 'Podcast',
		title: 'Podcast on Spotify',
		text: 'Full show on Spotify.',
		link: links.spotifyShow,
		linkLabel: 'Spotify',
	},
];

const press = [
	{ title: 'Geektime', text: 'The founders never met until this photo: Whatslly raises $11M.', link: links.geektimeSeed },
	{ title: 'CTech by Calcalist', text: 'Coverage on CTech, Calcalist\'s English-language tech site.', link: links.ctechArticle },
	{ title: 'Calcalist', text: 'Coverage in Calcalist. In Hebrew.', link: links.calcalistArticle },
	{ title: 'Start-Up Nation Central', text: 'Tuvis company profile.', link: links.startupNationTuvis },
	{ title: 'Crunchbase', text: 'My founder profile.', link: links.crunchbase },
];
---

<section id="media" class="block">
	<div class="wrap">
		<div class="block-head">
			<h2>Talks and interviews</h2>
			<p>
				I speak about founder-led sales, testing ideas before building them, selling into Latin America, and what
				actually happened at Tuvis.
			</p>
		</div>
		<div class="indent">
			<div class="videos">
				{videos.map((v) => (
					<figure>
						<button
							type="button"
							class="yt-embed"
							data-yt-id={v.id}
							aria-label={`Play video: ${v.title}`}
							style={`background-image: url('https://i.ytimg.com/vi/${v.id}/hqdefault.jpg');`}
						></button>
						<figcaption>
							<strong>{v.title}</strong>
							{v.text}
						</figcaption>
					</figure>
				))}
			</div>
		</div>
		<ul class="ledger list">
			{podcasts.map((p) => (
				<li>
					<span class="when">{p.when}</span>
					<div>
						<h3>{p.title}</h3>
						<p>{p.text}</p>
						<p class="meta"><a href={p.link} target="_blank" rel="noopener">{p.linkLabel}</a></p>
					</div>
				</li>
			))}
		</ul>
		<ul class="ledger list">
			{press.map((p) => (
				<li>
					<span class="when">Press</span>
					<div>
						<h3>{p.title}</h3>
						<p>{p.text}</p>
						<p class="meta"><a href={p.link} target="_blank" rel="noopener">Read</a></p>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.list {
		margin-top: 40px;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('.yt-embed').forEach((el) => {
		el.addEventListener('click', () => {
			const id = el.dataset.ytId;
			const label = el.getAttribute('aria-label') ?? 'YouTube video';
			const wrap = document.createElement('div');
			wrap.style.aspectRatio = '16 / 9';
			wrap.innerHTML = `<iframe width="100%" height="100%" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
			wrap.querySelector('iframe')!.title = label.replace('Play video: ', '');
			el.replaceWith(wrap);
			wrap.querySelector('iframe')!.focus();
		});
	});
</script>
