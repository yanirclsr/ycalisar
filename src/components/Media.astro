---
import { links } from '../data/links';

const youtubeId = 'z-7wHEJY8P8';

const run710Videos = [
	{
		id: 'mdlvfRhraw0',
		title: 'Remembering October 7 through running',
		hook: 'On Run 7.10 — why people across Israel meet, remember, and run 7.10 km together.',
	},
	{
		id: 'YlX_jZ-ZMUs',
		title: 'Knesset Channel interview — Run 7.10',
		titleHe: 'ראיון עם יניר קליסר בערוץ הכנסת בנושא מיזם רצים 7.10',
		hook: 'Interview on the Run 7.10 initiative (Hebrew).',
	},
];
---

<section id="media" style="background: var(--bg-elevated);">
	<div class="wrap">
		<p class="eyebrow reveal">Interviews & writing</p>
		<h2 class="section-title reveal">In my own words.</h2>

		<div class="grid cols-2">
			<div class="card reveal">
				<div
					class="yt-embed"
					data-yt-id={youtubeId}
					style={`position: relative; aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; cursor: pointer; background: #000 url('https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg') center/cover;`}
				>
					<span
						style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;"
					>
						<span style="width: 56px; height: 56px; border-radius: 999px; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; color: #0a0a0d;">▶</span>
					</span>
				</div>
				<p style="margin-top: 14px; font-weight: 600;">20 Minute Leaders — the Tuvis journey</p>
				<p class="hook">A conversation on building Whatslly/Tuvis from idea to enterprise scale.</p>
			</div>

			<div class="card reveal">
				<a href={links.nomadPodcast} target="_blank" rel="noopener" style="text-decoration: none; display: block;">
					<div style="aspect-ratio: 16/9; border-radius: 10px; background: linear-gradient(135deg, var(--accent-dim), var(--bg-card)); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border);">
						<span style="font-size: 2rem;">🎙️</span>
					</div>
					<p style="margin-top: 14px; font-weight: 600;">Nomad Podcast — Ep. 41</p>
					<p class="hook">Recorded in Koh Tao, Thailand — on running 15 SaaS products, lean validation, and diving.</p>
				</a>
			</div>
			<div class="card reveal">
				<a href={links.productBuilderPodcast} target="_blank" rel="noopener" style="text-decoration: none; display: block;">
					<div style="aspect-ratio: 16/9; border-radius: 10px; background: linear-gradient(135deg, var(--accent-dim), var(--bg-card)); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border);">
						<span style="font-size: 2rem;">🎧</span>
					</div>
					<p style="margin-top: 14px; font-weight: 600;">Product Builder podcast — May 2025</p>
					<p class="hook" dir="rtl" lang="he" style="text-align: left;">איך בונים מוצר לאנטרפרייז עם מאות לקוחות בסופ״ש?</p>
					<p class="hook">How to build an enterprise product with hundreds of customers over a weekend (Hebrew).</p>
				</a>
			</div>
			{run710Videos.map((v) => (
				<div class="card reveal">
					<div
						class="yt-embed"
						data-yt-id={v.id}
						role="button"
						tabindex="0"
						aria-label={`Play video: ${v.title}`}
						style={`position: relative; aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; cursor: pointer; background: #000 url('https://i.ytimg.com/vi/${v.id}/hqdefault.jpg') center/cover;`}
					>
						<span style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;">
							<span style="width: 56px; height: 56px; border-radius: 999px; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; color: #0a0a0d;">▶</span>
						</span>
					</div>
					<p style="margin-top: 14px; font-weight: 600;">{v.title}</p>
					{v.titleHe && <p class="hook" dir="rtl" lang="he">{v.titleHe}</p>}
					<p class="hook">{v.hook}</p>
				</div>
			))}
		</div>

		<div class="link-row reveal" style="margin-top: 24px;">
			<a class="btn" href={links.slideshare} target="_blank" rel="noopener">SlideShare — talks & workshops</a>
			<a class="btn" href={links.f6s} target="_blank" rel="noopener">F6S profile</a>
			<a class="btn" href={links.github} target="_blank" rel="noopener">GitHub — open source</a>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.yt-embed').forEach((el) => {
		const play = () => {
			const id = el.dataset.ytId;
			el.outerHTML = `<div style="aspect-ratio:16/9;border-radius:10px;overflow:hidden;"><iframe width="100%" height="100%" src="https://www.youtube.com/embed/${id}?autoplay=1" title="YouTube video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>`;
		};
		el.addEventListener('click', play);
		el.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				play();
			}
		});
	});
</script>
